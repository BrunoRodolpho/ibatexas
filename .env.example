# WARNING: Change all default passwords for non-local environments  # AUDIT-FIX: INFRA-15

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                        # console.anthropic.com
OPENAI_API_KEY=                           # platform.openai.com (fallback LLM)

ANTHROPIC_MODEL=claude-sonnet-4-6         # REQUIRED at boot — LLM model for agent responses (no in-code fallback)

# Local-model validation (opt-in; defaults to Anthropic when LLM_PROVIDER is unset).
# LLM_PROVIDER=ollama routes the semantic parser to a local Ollama OpenAI-compatible
# /v1 endpoint via @claustrum/openai's OpenAIProvider. The kernel stays authoritative.
# LLM_PROVIDER=ollama                     # unset = Anthropic; "ollama" = local endpoint
# LLM_BASE_URL=http://localhost:11434/v1  # Ollama /v1 endpoint (set to the box's IP for a LAN host)
# LLM_MODEL=nemotron-3-nano:4b            # served chat model id (falls back to ANTHROPIC_MODEL)
# LLM_API_KEY=ollama                      # ignored by Ollama; any non-empty bearer
# IBX_OLLAMA_SCHEME=http                   # scheme for the journeys-harness default Ollama base URL (LAN box speaks http)

# Agent tuning (all have sensible defaults — override only if needed)
AGENT_SESSION_TOKEN_BUDGET=100000         # AUDIT-FIX: AI-F03 — per-session cumulative token cap
# F5 config-seal boot gate. UNSET = no-op (safe default). Mint with `ibx kernel seal`
# and paste the printed line here to fail boot CLOSED on pack config drift.
CONFIG_SEAL_DIGESTS=                      # e.g. ibatexas/pack-orders=<64hex>;ibatexas/pack-payments=<64hex>
# F3 behavioral-drift detector thresholds (PromQL alerts; calibrate before paging)
IBX_DRIFT_BASELINE_WINDOW=500             # records forming the frozen baseline window
IBX_DRIFT_THRESHOLD=0.35                  # TVD/proportion-delta in [0,1] above which drift fires
IBX_DRIFT_EVAL_INTERVAL_MS=60000          # how often the drift-evaluate job recomputes drift → /metrics

# ─── App Environment ─────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production — namespaces Redis keys
NODE_ENV=development                       # development | production — gates dev-OTP bypass + dev-only QA routes; set production in prod

# ─── Adjudicate Kernel ───────────────────────────────────────────────────────
# IBX-IGE v3.0: the kernel is always authoritative — no gating flags. Every
# mutation is adjudicated, every decision audited (console + NATS + Postgres),
# and the execution ledger always-on + fail-closed.
#
# First-time setup: `ibx bootstrap` applies the @adjudicate/audit-postgres
# SQL migrations to your DATABASE_URL. To re-run migrations only:
# `ibx kernel migrate`. See ADRs #9 + #14 for full architecture.

# ─── Claims pipeline + managed-agent plane (opt-in feature flags) ────────────
# Both default OFF — the assembled pipeline/plane is a designed no-op unless on.
ENABLE_CLAIMS_PIPELINE=false              # B-PR1 claims pipeline — default off; shadow-assembles validated claims when true
IBX_AGENTS_ENABLED=false                  # T3-9 managed-agent plane — default off; starts the plane when true

# W3 P0-1 / P0-2 / P1-I — refund + regeneration policy thresholds (centavos).
# Defaults match governance §"04-decision-policy.md" + pack-payments-pix.
REFUND_CONFIRM_THRESHOLD_CENTAVOS=50000        # > R$500 → REQUEST_CONFIRMATION (kernel)
REFUND_ESCALATE_THRESHOLD_CENTAVOS=100000      # > R$1000 → ESCALATE (kernel)
REFUND_DAILY_NO_CONFIRM_CAP_CENTAVOS=200000    # P1-I drip cap — R$2000/staff/day
MAX_PIX_REGENERATIONS_PER_PAYMENT=5            # P0-2 per-payment regen cap

# Pack-reservations thresholds (task 09). Hours before slot start within which
# a cancel triggers REQUEST_CONFIRMATION; fraction (0-1) above which a customer's
# historical no-show rate ESCALATEs new bookings to a human.
RESERVATION_CANCEL_CONFIRM_HOURS=2
RESERVATION_NO_SHOW_ESCALATE_RATE=0.3

# Pack-whatsapp thresholds (task 10). Rolling window (minutes) for the
# per-customer staff-handover rate limit — 2nd handover within the window
# triggers REQUEST_CONFIRMATION, 3rd+ triggers REFUSE
# (investigation 08 P1 #4). Grace seconds extend the WhatsApp Business
# 24-hour customer-initiated window before a free-form outbound is
# refused (Meta/Twilio policy).
WHATSAPP_HANDOFF_LIMIT_MINUTES=10
WHATSAPP_24H_WINDOW_GRACE_SECONDS=300

# Pack-customer-onboarding thresholds (task 21). Grace window (hours) between
# customer.anonymize DEFER and the route layer actually anonymizing — LGPD
# Art. 18 destructive-flow lighthouse. Rate-limit hours bound profile updates
# to deter takeover-via-rapid-update.
CUSTOMER_ANONYMIZE_GRACE_HOURS=24
CUSTOMER_PROFILE_RATE_LIMIT_HOURS=1

# ─── Payments ─────────────────────────────────────────────────────────────────
# All three keys from dashboard.stripe.com → API keys / Webhooks:
#   STRIPE_SECRET_KEY (sk_*)         — backend only. Full API access: create PaymentIntents, refunds, read customers.
#   STRIPE_WEBHOOK_SECRET (whsec_*)  — backend only. Verifies incoming webhook POSTs are genuinely from Stripe.
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_*) — frontend (browser). Initializes Stripe.js for card form + payment confirmation. Safe to expose.
STRIPE_SECRET_KEY=                        # dashboard.stripe.com → API keys → Secret key. sk_live_* vs sk_test_* also gates the webhook: P3-SEC-STRIPESRC refuses any event whose livemode ≠ this key's mode.
STRIPE_WEBHOOK_SECRET=                    # dashboard.stripe.com → Webhooks → Signing secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # dashboard.stripe.com → API keys → Publishable key
# Future: Pix checkout integration (Stripe Pix payment method ID, dashboard → payment methods)
STALE_ORDER_THRESHOLD_HOURS=24           # hours before an unpaid pending order is auto-canceled
STALE_ORDER_DRY_RUN=false                # true = log but don't cancel stale orders
# BKL-092 staff-auth infra-error ops-alert (middleware/auth.ts). A DB failure in
# the per-request staff active-recheck (schema drift / connectivity) logs a
# structured ERROR and, once this many occur within the window, raises a governed
# `ops_staff_auth_infra` ops-alert. Both env-overridable; defaults below.
STAFF_AUTH_INFRA_ALERT_THRESHOLD=3         # infra errors in the window before the ops-alert raises
STAFF_AUTH_INFRA_ALERT_WINDOW_SECONDS=300  # fixed counter window, seconds
# P3-SCALE-RETENTION: daily retention cleaner for the two append-only tables
# (conversation_messages by sent_at + order_event_log by created_at). OPT-IN — leave
# RETENTION_DAYS unset (or <= 0) to disable; there is deliberately NO default retention,
# so data is never deleted unless you configure a window. order_event_log is a replayable
# observability layer (NOT the order ledger), and conversation messages are archived
# transcripts (Redis is the hot path) — both are safe to age out.
# RETENTION_DAYS=365                     # delete rows older than N days (unset/<=0 = disabled)
RETENTION_DRY_RUN=false                  # true = count + log what would be deleted, delete nothing
# RETENTION_BATCH_SIZE=1000              # rows deleted per batch (bounds each transaction)
# TURN_TRACE_RETENTION_DAYS=30           # INDEPENDENT, typically shorter window for the
#                                        # turn_trace store (prompt/completion LLM-call trace).
#                                        # F3: DEFAULTS to 30 days when unset (imperfect redaction
#                                        # → must not grow unbounded). Set <=0 to OPT OUT explicitly
#                                        # (logged loudly; retains residual PII indefinitely).
# LLM_TOKEN_USAGE_RETENTION_DAYS=30      # INDEPENDENT, DEDICATED window for the llm_token_usage
#                                        # cost-telemetry table (item C / #94-16). DEFAULTS to 30
#                                        # when unset (NOT opt-in like RETENTION_DAYS — else the
#                                        # table grows unbounded). Set <=0 to OPT OUT explicitly.
# AGENT_APPROVAL_MIRROR_TTL_SECONDS=86400 # TTL (s) for the agent-approval Redis display mirror
#                                        # (#92-2). Threaded into BOTH the registry and the bridge
#                                        # so pending + resolved rows expire on one clock. Default 24h.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev uses docker-compose Postgres on port 5433.
# Production uses Supabase managed Postgres — see docs/setup/supabase.md.
POSTGRES_USER=ibatexas                    # docker-compose postgres user
POSTGRES_PASSWORD=ibatexas               # docker-compose postgres password
POSTGRES_DB=ibatexas                     # docker-compose postgres database name
POSTGRES_PORT=5433                        # docker-compose postgres host port (5433 avoids conflict with local postgres)
# DATABASE_URL — Prisma query engine connection.
#   Local:      postgresql://ibatexas:ibatexas@localhost:5433/ibatexas
#   Supabase:   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?connection_limit=10&pool_timeout=30&pgbouncer=true
DATABASE_URL=postgresql://ibatexas:ibatexas@localhost:5433/ibatexas
# DIRECT_DATABASE_URL — used by Prisma for migrations only (bypasses PgBouncer).
#   Local:      same as DATABASE_URL
#   Supabase:   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://ibatexas:ibatexas@localhost:5433/ibatexas

# ─── Cache ────────────────────────────────────────────────────────────────────
# AUDIT-FIX: INFRA-12 — REDIS_URL must include the password when REDIS_PASSWORD is set.
# Local default: redis://:localdev@localhost:6379
# Production example: redis://:YOUR_STRONG_PASSWORD@redis-host:6379
REDIS_PASSWORD=localdev                   # AUDIT-FIX: INFRA-12 — Redis requirepass (change for non-local envs)
REDIS_URL=redis://:localdev@localhost:6379
REDIS_CB_FAILURE_THRESHOLD=5                 # circuit breaker: failures before opening (default 5)
REDIS_CB_RESET_TIMEOUT_MS=30000              # circuit breaker: reset timeout in ms (default 30s)
REDIS_CONNECT_TIMEOUT_MS=5000                # AUDIT-FIX P2-NET-REDISTIMEOUT — Redis socket connect timeout (no more wait-forever)
REDIS_MAX_RECONNECT_ATTEMPTS=10              # AUDIT-FIX P2-NET-REDISTIMEOUT — bounded reconnect attempts before erroring out
REDIS_RECONNECT_MAX_DELAY_MS=3000            # AUDIT-FIX P2-NET-REDISTIMEOUT — cap on reconnect backoff delay
MAX_DLQ=1000                                 # AUDIT-FIX P2-SCALE-DLQCAP — max entries kept per DLQ list (lTrim cap; oldest dropped)

# ─── Search ───────────────────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=ibatexas-local-key
TYPESENSE_PROTOCOL=http                        # http (dev) or https (prod)
TYPESENSE_TIMEOUT_SECONDS=10
TYPESENSE_COLLECTION_NAME=products             # allows test isolation & multi-tenant deployments

# ─── Embeddings & RAG ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small                # (was CLAUDE_EMBEDDING_MODEL — old name still works as fallback)
EMBEDDING_MODEL_ID=text-embedding-3-small             # REQUIRED at boot — claustrum grounding (pgvector); id stamped on retrieval proofs
CLAUSTRUM_GROUNDING_ENABLED=false                     # only true when the model provider can actually embed; otherwise grounding runs as a designed no-op (DEF-005)
OPENAI_BASE_URL=https://api.openai.com/v1     # override for proxy / Azure OpenAI / local LLM
EMBEDDING_DIMENSION=1536                       # 1536 = text-embedding-3-small; 3072 = text-embedding-3-large
EMBEDDINGS_CACHE_TTL_SECONDS=2592000     # 30 days; product embeddings cached in Redis
QUERY_CACHE_TTL_SECONDS=3600             # 1 hour; static query cache TTL
QUERY_CACHE_DYNAMIC_TTL_SECONDS=600      # 10 min; TTL for availability-sensitive queries
QUERY_CACHE_EXACT_TTL_SECONDS=300        # 5 min; L0 exact query cache TTL
QUERY_LOG_TTL_SECONDS=604800             # 7 days; query log retention in Redis

# ─── Restaurant Configuration ─────────────────────────────────────────────────
RESTAURANT_TIMEZONE=America/Sao_Paulo
# Schedule hours below are SEED VALUES — used only to populate the DB on first startup.
# After that, hours are managed via Admin UI → Horários. These env vars become fallbacks only.
RESTAURANT_LUNCH_START_HOUR=11
RESTAURANT_LUNCH_END_HOUR=15
RESTAURANT_DINNER_START_HOUR=18
RESTAURANT_DINNER_END_HOUR=23
RESTAURANT_PHONE=
RESTAURANT_SITE_URL=https://ibatexas.com.br
RESTAURANT_LAT=                              # restaurant latitude (weather-based demand prediction)
RESTAURANT_LNG=                              # restaurant longitude (weather-based demand prediction)
HESITATION_NUDGE_DELAY_MS=45000            # ms delay before sending R$15 credit nudge to new customers (default 45s)
NO_SHOW_GRACE_MINUTES=15                  # minutes after slot start before marking as no-show

# ─── PONR (Point of No Return) ──────────────────────────────────────────────
PONR_DEFAULT_AMEND_MINUTES=5                 # default amend window per product (minutes after order placed)
PONR_DEFAULT_CANCEL_MINUTES=5                # default cancel window per product (minutes after order placed)
PONR_DAY_OVERRIDES={}                        # JSON: per-day-of-week overrides, e.g. {"saturday":{"amendMinutes":15,"cancelMinutes":15},"monday":{"amendMinutes":0,"cancelMinutes":0}}

# ─── Messaging ────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
# T3-10 — NATS server-side auth is NOW ENFORCED (W4 P0-12 wired the client
# pickup; T3-10 executed docs/security/NATS-AUTH-REQUIREMENTS.md server-side).
# The dev compose NATS (docker-compose.yml + infra/nats/nats-server.app.conf)
# REFUSES unauthenticated clients. Provision the per-machine pair with
#   ./scripts/nats/gen-dev-nats-auth.sh
# which fills BOTH vars below (seed = client credential read by
# @ibatexas/nats-client; public key = server-side authorization interpolated
# into the NATS config by docker compose). Never share seeds across machines
# or environments; rotate with --force.
NATS_CREDS_PATH=                          # path to a .creds file (JWT-bearer auth) — full nsc/JWT alternative for prod
NATS_NKEY_SEED=                           # nkey seed string ("SU...") — client credential (generated)
NATS_APP_NKEY_PUBLIC=                     # matching public key ("U...") — consumed by the NATS SERVER config (generated)
NATS_TLS_CA=                              # path to PEM CA cert for the NATS server
NATS_TLS_REQUIRED=                        # "true" to fail-closed if server does not offer TLS
# NATS_JETSTREAM_ENABLED=false            # at-least-once migration Phase 0: "true" provisions the durable
#                                         # JetStream streams at boot (additive — does not change Core NATS
#                                         # delivery yet). See ~/projects/jetstream-at-least-once-plan.md
# JetStream at-least-once tuning — read at runtime in @ibatexas/nats-client
# (packages/nats-client/src/index.ts) with the defaults shown below; override only
# to tune redelivery/backoff. Effective only when NATS_JETSTREAM_ENABLED=true.
# NATS_JS_MAX_DELIVER=5                    # max delivery attempts before term -> DLQ
# NATS_JS_ACK_WAIT_MS=30000                # ack wait before redelivery (ms)
# NATS_JS_NAK_BASE_MS=1000                 # nak backoff base (ms); linear: min(attempt*base, NAK_MAX)
# NATS_JS_NAK_MAX_MS=30000                 # nak backoff cap (ms)
NATS_MAX_PENDING_MSGS=10000               # AUDIT-FIX P2-MEM-NATSPENDING — per-subscription in-flight backlog cap; under burst, excess fire-and-forget Core NATS messages are dropped (not JetStream) and warn-logged instead of buffering unbounded. <=0 disables the bound
OUTBOX_MAX_LEN=5000                       # AUDIT-FIX P1-SCALE-OUTBOXMEM — hard cap (lTrim) on each per-event outbox list so a prolonged NATS outage can't grow it unbounded; newest entries kept. <=0 disables the bound
OUTBOX_PAGE_SIZE=500                      # AUDIT-FIX P1-SCALE-OUTBOXMEM — outbox-retry reads at most N head entries per event per cycle (bounded LRANGE) instead of the whole list

# ─── Web chat (SSE) ───────────────────────────────────────────────────────────
SSE_HEARTBEAT_MS=15000                    # AUDIT-FIX P2-MEM-SSEHEARTBEAT — periodic `: ping` keep-alive on the chat SSE stream so a half-open socket can't leak the response + its emitter/Redis subscriber. 0 disables


# ─── Rate Limiting ────────────────────────────────────────────────────────────
# RATE_LIMIT_MAX — max global HTTP requests per IP per 1-minute window
# (apps/api/src/plugins/rate-limit.ts). Optional: defaults to 30 in production,
# 200 otherwise. The time window is fixed at 1 minute and is NOT env-configurable.
# RATE_LIMIT_MAX=30

# ─── Session ──────────────────────────────────────────────────────────────────
# SESSION_MAX_AGE_SECONDS=86400           # customer session lifetime in seconds (default: 86400 = 24h)

# ─── PIX Delays ───────────────────────────────────────────────────────────────
# PIX_CONFIRM_DELAY_MS=0                  # artificial delay (ms) before confirming a PIX payment (default: 0; set >0 for testing)
# PIX_EXPIRE_POLL_INTERVAL_MS=60000       # interval (ms) between PIX expiry polling cycles (default: 60000 = 1 minute)
PIX_REMINDER_SENT_TTL_SECONDS=3600       # AUDIT-FIX P3-NET-PIXREMINDER — TTL (s) for the per-stage "reminder/expiry already sent" NX key that stops a BullMQ retry from re-sending the WhatsApp message (default 1h)

# ─── Ops channel history (BKL-084) ───────────────────────────────────────────
# The staff ops channel (POST /api/admin/ops/chat) persists a per-staff thread on
# its own OPS-namespaced Redis list and threads a bounded, DATA-fenced history
# block into the planner so anaphora ("e o brisket?") resolves.
# OPS_HISTORY_TURNS=8                     # prior turns (user+assistant pairs) rendered into the context block (min 1, default 8)
# OPS_HISTORY_MAX_CHARS=2000              # hard char cap on the rendered history body, excluding the fence (min 200, default 2000)
# OPS_HISTORY_RETENTION=50               # max messages retained per staff in Redis, LTRIM window (min 2, default 50)
# OPS_HISTORY_TTL_SECONDS=172800         # TTL (s) reset on each append (min 60, default 172800 = 48h)

# ─── Ops product name→id resolution (BKL-089) ────────────────────────────────
# The staff ops plane resolves a spoken product NAME ("acabou a picanha") to a
# real productId deterministically before adjudication, using the admin catalog
# list read. This caps how many candidates the read returns (q narrows first).
# OPS_PRODUCT_RESOLUTION_LIMIT=50         # candidate page size for name resolution (default 50)

# ─── Ops order reference→id resolution (BKL-089) ─────────────────────────────
# The staff ops plane resolves a spoken order REFERENCE — the display number
# ("avança o 4242") or a customer name ("nota no pedido da Maria") — to a real
# orderId deterministically before adjudication, reusing the admin OrderQueryService
# reads. displayId resolves on an EXACTLY-ONE match (no window); customer name
# resolves only against a single RECENT ACTIVE (non-terminal) order.
# OPS_ORDER_DISPLAYID_MATCH_LIMIT=5       # rows fetched per displayId — only bounds the read + detects duplicates (default 5)
# OPS_ORDER_RECENT_WINDOW_HOURS=168       # look-back window for name matching, hours (default 168 = 7d)
# OPS_ORDER_RECENT_LIMIT=200              # recent-orders page size scanned for name matching (default 200)

# ─── Ops price change by message (NEW-004) ───────────────────────────────────
# The staff ops plane re-prices a product by message ("aumenta o preço da picanha
# pra 95 reais"). A model-parsed price ALWAYS REQUEST_CONFIRMATIONs (name + old→new
# BRL); this caps the absurd-price sanity REFUSE ceiling (a gross misparse). Price
# is reversible, so there is no ESCALATE band — this is a defensive cap only.
# OPS_PRICE_MAX_CENTAVOS=10000000         # sanity ceiling; above → REFUSE out_of_range (default R$100.000,00)

# ─── JWT Alignment ────────────────────────────────────────────────────────────
# JWT_MIN_SECRET_LENGTH=32                # minimum length (bytes) enforced for JWT_SECRET at startup (default: 32)
# JWT_ALGORITHM=HS256                     # HMAC algorithm for signed JWTs (default: HS256; options: HS256, HS384, HS512)

# ─── Server ──────────────────────────────────────────────────────────────────
TRUST_PROXY=true                          # AUDIT-FIX: SEC-F13 — Set to true when behind a reverse proxy (ALB, nginx, Cloudflare)

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                               # sentry.io
SENTRY_ENVIRONMENT=                       # development | staging | production (defaults to APP_ENV)
NEXT_PUBLIC_SENTRY_DSN=                   # same DSN for Next.js apps (client-side)
LOG_LEVEL=info                            # pino log level: trace | debug | info | warn | error | fatal
ENABLE_SWAGGER=true                       # set to "false" to disable /docs endpoint
NEXT_PUBLIC_POSTHOG_KEY=                  # us.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
GRAFANA_URL=http://localhost:3030         # local Grafana base URL shown by `ibx dev urls` (obs stack)
VICTORIALOGS_URL=http://localhost:9428    # ship structured pino logs to VictoriaLogs (obs stack); unset = stdout only
EMERGENCY_REDIS_KEY=adjudicate:kill-switch # shared kill-switch key the adj-console reads for live emergency state (P0)

# ─── Adjudicate Kernel ────────────────────────────────────────────────────────
PROMETHEUS_TOKEN=ibatexas-dev-prom-token   # token to scrape GET /metrics; MUST equal infra/victoriametrics/scrape.yml header (503 when unset)
# Audit-redactor salt (task 18 / M4). HMAC-style secret mixed into the
# truncated SHA-256 hash that replaces `name` / `address` / `customerId`
# payload fields AND `actor.sessionId` (phone hashes, `admin:{staffId}`) in
# AuditRecord before sinks emit. REQUIRED in production — a leaked audit log
# with an empty salt is rainbow-table-attackable back to plaintext identities.
# Generate with `openssl rand -base64 32`.
# BKL-093: production FAILS CLOSED at boot when this is empty/absent (mirrors the
# ADMIN_API_KEY prod check); dev keeps a boot WARN and hashes unsalted.
AUDIT_REDACT_SECRET=                       # 32+ char random; empty ⇒ dev WARN, prod boot throw
# AUT-025 — production audit-record signing (ed25519). Signs the record's
# `audit_hash` (post-redaction) so `intent_audit.signature_jsonb` carries a
# non-repudiation signature verifiable via `ibx kernel audit-verify`. Both the
# private key AND key id are required in production — absent/invalid FAILS
# CLOSED at boot (self-test sign+verify). Dev leaves them empty ⇒ unsigned rows
# + a one-shot WARN. A key that is PRESENT but invalid throws in any env.
# Generate a keypair (base64 DER — PKCS8 private / SPKI public — single-line):
#   node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('ed25519');\
#   console.log('PRIV',privateKey.export({format:'der',type:'pkcs8'}).toString('base64'));\
#   console.log('PUB ',publicKey.export({format:'der',type:'spki'}).toString('base64'))"
AUDIT_SIGNING_PRIVATE_KEY=                  # base64 PKCS8 DER (or PEM) ed25519 private key; empty ⇒ dev unsigned, prod boot throw
AUDIT_SIGNING_KEY_ID=                       # stable key identifier recorded into signature_jsonb.keyId (e.g. "ibx-audit-2026-07")
AUDIT_SIGNING_PUBLIC_KEY=                   # base64 SPKI DER (or PEM) ed25519 public key; used by `ibx kernel audit-verify`
# Audit Postgres durable sink (task 19 / M4). When "true" the in-process
# multi-sink composes `@adjudicate/audit-postgres.createPostgresSink` and the
# `audit-consumer` NATS subscriber writes redundancy rows to the same table.
# Both wire together — never enable one without the other.
# Schema TODO: requires the `intent_audit` table from
# `@adjudicate/audit-postgres/migrations/001-008` to exist. A Prisma model +
# migration is deferred to the follow-up task documented in
# docs/adjudicate-migration/tasks/19-audit-postgres-sink.md.
IBX_AUDIT_POSTGRES_ENABLED=false           # flip to true after 7-day staging soak (runbook 04)
# In-memory buffer capacity before audit records spill to Redis-backed
# durable storage. 1000 ≈ 30s of normal traffic at 30 RPS. Tune up on
# high-traffic deployments; tune down on low-RAM hosts.
IBX_AUDIT_BUFFER_CAPACITY=1000             # records held in memory before Redis spill kicks in

# ─── WhatsApp + Auth (Twilio) — Customer ─────────────────────────────────────
TWILIO_ACCOUNT_SID=                       # console.twilio.com — customer account
TWILIO_AUTH_TOKEN=                        # console.twilio.com — customer account
TWILIO_VERIFY_SID=                        # console.twilio.com → Verify → create service → Service SID
TWILIO_OTP_CHANNEL=sms                    # sms (default) or whatsapp (requires approved WhatsApp Business sender on Verify service)
# DEV OTP bypass (WS-E — LOCAL DEV ONLY): skip the real Twilio Verify round-trip
# so you can log in / test amend-cancel-via-chat without spending SMS. HARD-GATED:
# only active when NODE_ENV=development AND IBX_DEV_OTP_BYPASS=true AND a code is
# set. Issues the REAL customer JWT. NEVER set these in test/staging/production.
IBX_DEV_OTP_BYPASS=false                  # true to accept IBX_DEV_OTP_CODE without Twilio (dev only)
IBX_DEV_OTP_CODE=                         # the fixed code verify-otp accepts under the bypass (e.g. 424242)
TWILIO_WHATSAPP_NUMBER=                   # e.g. whatsapp:+14155238886 (sandbox or approved number)
TWILIO_WEBHOOK_URL=                       # Full public URL for WhatsApp webhook signature verification (e.g. https://bot.ibatexas.com.br/api/webhooks/whatsapp)
WHATSAPP_SEND_RATE_PER_SECOND=10          # AUDIT-FIX P1-SCALE-TWILIORATE — shared Redis token-bucket refill rate per sending number (proactive Twilio per-second cap)
WHATSAPP_SEND_RATE_BURST=20               # AUDIT-FIX P1-SCALE-TWILIORATE — token-bucket burst capacity (defaults to WHATSAPP_SEND_RATE_PER_SECOND if unset)
WA_TURN_TIMEOUT_MS=60000                  # AUDIT-FIX P2-CONC-ABORT — max WhatsApp turn duration before the stale outbound render is suppressed
WA_EMPTY_COMPLETION_HOLDING=false         # W1 no-reply incident — when true, send a pt-BR holding message to the WhatsApp customer on an empty/whitespace completion (the customer harm-reducer; the single send-site substitution; sent strictly after classify+emit+incident-open). Recommended: true in prod.
WEB_EMPTY_COMPLETION_HOLDING=false        # W1 no-reply incident (web/chat plane, P1-9) — web sibling of WA_EMPTY_COMPLETION_HOLDING. When true, push ONE pt-BR holding chunk over the SSE stream on an empty/whitespace completion instead of a bare {type:"done"} (the customer harm-reducer; pushed strictly after classify+emit+incident-open). Recommended: true in prod.
EMPTY_COMPLETION_MAX_ATTEMPTS=3           # F6 (BKL-031) — total responder-completion attempts (incl. the first) before falling back to the holding message. The 4B empties ~22% of the time; retry-on-empty (bounded, jittered) cuts ghosting. 1 disables retry. Applies to the responder completion seam only.

# ─── Staff/Admin Twilio (separate account) ────────────────────────────────────
# Falls back to TWILIO_* vars above if not set
TWILIO_STAFF_ACCOUNT_SID=                 # console.twilio.com — staff/admin account
TWILIO_STAFF_AUTH_TOKEN=                  # console.twilio.com — staff/admin account
TWILIO_STAFF_VERIFY_SID=                  # console.twilio.com → Verify → create service → Service SID (staff)
TWILIO_STAFF_OTP_CHANNEL=sms              # sms or whatsapp for staff OTP
STAFF_NOTIFICATION_PHONE=                 # Staff WhatsApp number for handoff notifications (e.g. whatsapp:+5511999990000)
STAFF_ALERT_PHONE=                        # Staff WhatsApp number for high-value cart alerts (plain number, e.g. +5511999990000)

# ─── PIX Payment ─────────────────────────────────────────────────────────────
PIX_FALLBACK_EMAIL=pedido@ibatexas.com.br  # Fallback email for Stripe PIX billing_details (WhatsApp users don't have email)
PIX_FALLBACK_TAX_ID=                        # Restaurant CNPJ for Stripe PIX billing_details (e.g. 12.345.678/0001-90). Required if Stripe account is US-based.
PIX_EXPIRY_SECONDS=3600                     # PIX QR code expiry in seconds (default 1h, max 3 days = 259200)

# ─── Session Security ────────────────────────────────────────────────────────
SESSION_HMAC_SECRET=                      # min 32 chars — HMAC-SHA256 secret for signed session tokens (fails closed in prod; placeholders rejected) — openssl rand -base64 32
PHONE_HASH_PEPPER=                        # min 32 chars — server-side pepper for the keyed-HMAC phone pseudonym (logs + Redis keys) — openssl rand -base64 32

# ─── Admin API ────────────────────────────────────────────────────────────────
ADMIN_API_KEY=                            # API key for admin routes — openssl rand -base64 32 (server-side only, used by apps/admin proxy route)
# W4 P1-H — map each API key to a role so destructive routes fail-closed for
# unmapped keys. JSON: {"<api-key>":"OWNER"|"MANAGER"}. Keys absent from this
# map can still call read-only admin routes (the outer auth accepts them),
# but routes guarded by requireManagerRole/requireOwnerRole return 403.
ADMIN_API_KEY_ROLES_JSON=                 # e.g. '{"abc...32-chars":"MANAGER","def...32-chars":"OWNER"}'

# ─── Medusa Admin Credentials ────────────────────────────────────────────────
# These also power server-side admin API auth: packages/tools/src/medusa/client.ts
# obtains a Bearer JWT via /auth/user/emailpass and caches it. No sk_ secret key
# needed — Medusa v2 admin middleware doesn't accept Basic auth. The publishable
# key for /store/* is auto-resolved at runtime from /admin/api-keys on first use,
# so it never needs to live in .env either.
MEDUSA_ADMIN_EMAIL=admin@ibatexas.com.br  # Medusa admin dashboard login email
MEDUSA_ADMIN_PASSWORD=                    # Medusa admin dashboard login password — min 8 chars

# ─── Medusa Secrets ───────────────────────────────────────────────────────────
JWT_SECRET=                               # min 32 chars — openssl rand -base64 32 — signs CUSTOMER JWTs (apps/api)
# JWTSPLIT (audit): dedicated key that signs STAFF JWTs (apps/api). MUST be a DIFFERENT
# value from JWT_SECRET — the server refuses to boot if they match — so a leak of the
# customer key cannot forge staff tokens (and vice versa). min 32 chars.
STAFF_JWT_SECRET=                          # min 32 chars — openssl rand -base64 32 — MUST differ from JWT_SECRET
WEB_GATEWAY_SIGNING_KEY=                   # min 32 chars — openssl rand -base64 32 — HMAC the conductor trusts for web-gateway messages (requireSecret; fails closed dev/prod)
SYSTEM_GATEWAY_SIGNING_KEY=                # min 32 chars — openssl rand -base64 32 — HMAC for the system agent-host channel (requireSecret; fails closed dev/prod)
COOKIE_SECRET=                            # min 32 chars — openssl rand -base64 32
# AUDIT-FIX: SEC-F11 — CORS_ORIGIN must include both web and admin origins, comma-separated
# (e.g., http://localhost:3000,http://localhost:3002 for dev; https://ibatexas.com.br,https://admin.ibatexas.com.br for prod)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
STORE_CORS=http://localhost:3000          # storefront origin (comma-separated for multiple)
ADMIN_CORS=http://localhost:9000          # Medusa admin origin
AUTH_CORS=http://localhost:3000,http://localhost:9000  # auth endpoints CORS
MEDUSA_WORKER_MODE=shared                 # shared | worker | server

# ─── App URLs ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* URLs are inlined into the client bundle at Next.js build time
# AND used by next.config.mjs to build the CSP connect-src directive. In
# deployed envs (dev/staging/prod) they must point at the Caddy-fronted HTTPS
# origins (e.g. https://api.ibatexas.com.br) — set via CI build-args and
# re-injected into the runtime .env by the EC2 bootstrap script.
APP_BASE_URL=http://localhost:3000              # REQUIRED — public app URL (used for review prompt links, notifications)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_URL=http://localhost:9000          # alias used by catalog routes (same as MEDUSA_BACKEND_URL)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000  # Medusa admin URL, accessible from browser
WEB_URL=                                  # REQUIRED in production — public URL of the Next.js app (e.g. https://ibatexas.com.br)

# ─── Public Business Info (Footer/Contact) ───────────────────────────────────
NEXT_PUBLIC_PHONE=(17) 3341-5300
NEXT_PUBLIC_HOURS_WEEKDAY=11h - 23h
NEXT_PUBLIC_HOURS_SATURDAY=11h - 23h30
NEXT_PUBLIC_HOURS_SUNDAY=11h - 23h
NEXT_PUBLIC_INSTAGRAM_URL=               # e.g. https://instagram.com/ibatexas
NEXT_PUBLIC_FACEBOOK_URL=                # e.g. https://facebook.com/ibatexas
NEXT_PUBLIC_WHATSAPP_URL=                # e.g. https://wa.me/5517999999999

# ─── E2E Testing (Playwright) ───────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000  # storefront URL for Playwright web tests
PLAYWRIGHT_API_URL=http://localhost:3001   # API URL for Playwright API tests

# ─── Journey test stack (T1a-11a) ────────────────────────────────────────────
# The ephemeral LLM-journey test stack has its OWN env contract: .env.test
# (gitignored), generated from .env.test.example via ./scripts/gen-env-test.sh.
# Do NOT set IBX_TEST_FINGERPRINT or IBX_TEST_* port vars in this file — only
# the test profile carries them. See docs/setup/test-stack.md.

# ─── QA-viewer harness control (WS-B — DEV ONLY) ─────────────────────────────
# Lets the qa-viewer (:3010) drive `ibx journey/scenario/agent` runs against
# this API and stream them live. HARD-GATED: the routes self-disable in
# production and unless BOTH are set (token must be >=16 chars). Bearer-token
# auth only (no cookies). Leave unset outside local dev.
IBX_QA_CONTROL_ENABLED=false               # true to expose /internal/qa/* (dev only)
IBX_QA_CONTROL_TOKEN=                       # >=16 char bearer; the viewer sends it as VITE_QA_CONTROL_TOKEN
IBX_REPO_ROOT=                             # optional: repo root override for qa-control (defaults to walking up to pnpm-workspace.yaml)
