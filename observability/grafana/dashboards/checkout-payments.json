    {
      "type": "table",
      "title": "Errors by component",
      "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "stats",
          "expr": "_time:$__range level:>=50 | stats by (component) count() errors | sort by (errors desc)"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "logs",
      "title": "Failed webhook jobs (paid-but-stranded orders)",
      "id": 9,
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 5 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "instant",
          "expr": "_time:$__range component:\"job:stripe-webhook\" event:=job.failed"
        }
      ],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    },
    {
      "type": "logs",
      "title": "Medusa API errors (4xx/5xx — would have caught the expand→fields bug)",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "instant",
          "expr": "_time:$__range component:\"tools:medusa\" level:>=50"
        }
      ],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    },
    {
      "type": "logs",
      "title": "Slow / failed HTTP (4xx/5xx + >1s)",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "instant",
          "expr": "_time:$__range component:\"http\""
        }
      ],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    },
    {
      "type": "logs",
      "title": "Payment funnel trace (all stages — filter by payment_intent_id to follow one order)",
      "id": 12,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "instant",
          "expr": "_time:$__range component:\"job:stripe-webhook\" (event:=payment.received OR event:=order.completed OR event:=payment.captured OR event:=payment.reconciled OR event:=payment.duplicate OR event:=job.failed)"
        }
      ],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    }
