# .env.test.example — T1a-11a env contract for the ephemeral journey-test stack.
#
# This file is the COMMITTED template. The real file is .env.test (gitignored —
# never commit it): generate it with `./scripts/gen-env-test.sh`, which fills
# every __GENERATE__ placeholder with a fresh random secret, interpolates
# ANTHROPIC_API_KEY from your developer .env, and mints a unique
# IBX_TEST_FINGERPRINT.
#
# Two consumers read .env.test:
#   1. docker compose --env-file .env.test -f docker-compose.test.yml
#      (the IBX_TEST_* interpolation vars below — ports + infra credentials).
#   2. The process-compose test profile (T1a-11b) injecting the full block into
#      the api + commerce processes BEFORE boot — APP_ENV must be present at
#      process start because rk() in @ibatexas/tools captures it at module load.
#
# WHY EXPLICIT SECRETS: with NODE_ENV=test, a missing secret makes
# requireSecret() mint a RANDOM PER-PROCESS value — cross-process auth (api vs
# harness vs commerce) silently breaks. Every secret here is therefore explicit,
# >=32 chars, and distinct. JWT_SECRET and STAFF_JWT_SECRET MUST differ (the
# server refuses to boot if they match).
#
# ADDRESS DERIVATION: apps and the harness resolve infra addresses exclusively
# from DATABASE_URL / REDIS_URL / TYPESENSE_HOST+TYPESENSE_PORT / NATS_URL via
# infraEndpoints() (packages/cli/src/services.ts — the port source of truth).
# Keep those URLs in sync with the IBX_TEST_* values; gen-env-test.sh writes
# both from one set of inputs.
#
# Vars not listed here keep the defaults documented in .env.example.

# ─── Process identity ─────────────────────────────────────────────────────────
NODE_ENV=test
# APP_ENV namespaces every Redis key via rk() — "test" isolates keys even if a
# process is ever mispointed at a shared Redis (defense-in-depth; the primary
# isolation is the dedicated ephemeral redis container).
APP_ENV=test
# D-010 pin: ONLY the test profile sets this; /health exposes it as
# testFingerprint and the harness pre-flight (T1a-10) refuses to drive any
# stack that does not present it. Never set it in a dev or prod env file.
IBX_TEST_FINGERPRINT=__GENERATE__
PORT=3001
LOG_LEVEL=info

# ─── Test-compose interpolation (consumed by docker-compose.test.yml) ────────
# IBX_TEST_*-prefixed so the dev .env (auto-loaded by docker compose for
# substitution) can never influence the test stack. Defaults are distinct from
# the dev stack: postgres 5434/5433, redis 6380/6379, typesense 8109/8108,
# nats 4223/4222 + monitor 8223/8222.
IBX_TEST_POSTGRES_PORT=5434
IBX_TEST_POSTGRES_USER=ibatexas
IBX_TEST_POSTGRES_PASSWORD=__GENERATE__
IBX_TEST_POSTGRES_DB=ibatexas_test
IBX_TEST_REDIS_PORT=6380
IBX_TEST_REDIS_PASSWORD=__GENERATE__
IBX_TEST_TYPESENSE_PORT=8109
IBX_TEST_TYPESENSE_API_KEY=__GENERATE__
IBX_TEST_NATS_PORT=4223
IBX_TEST_NATS_MONITOR_PORT=8223
# T3-10 — NATS server-side auth: three nkey users in one account (see
# infra/nats/nats-server.test-plane.conf). The PUBLIC keys below are
# interpolated into the server config by docker-compose.test.yml (fail-loud
# :? guards); the matching SEEDS live in the client sections further down.
# gen-env-test.sh mints all three pairs per machine.
IBX_TEST_NATS_APP_NKEY_PUBLIC=__GENERATE_NKEY_APP_PUBLIC__
IBX_TEST_NATS_CAPTURE_NKEY_PUBLIC=__GENERATE_NKEY_CAPTURE_PUBLIC__
IBX_TEST_NATS_TRIGGER_NKEY_PUBLIC=__GENERATE_NKEY_TRIGGER_PUBLIC__

# ─── Infra addresses (MUST point at the test-stack ports above) ──────────────
# DATABASE_URL embeds IBX_TEST_POSTGRES_PASSWORD; db name ibatexas_test makes
# accidental cross-wiring to the dev postgres (db ibatexas) fail loudly.
DATABASE_URL=postgresql://ibatexas:__GENERATE__@localhost:5434/ibatexas_test
DIRECT_DATABASE_URL=postgresql://ibatexas:__GENERATE__@localhost:5434/ibatexas_test
# REDIS_PASSWORD must equal IBX_TEST_REDIS_PASSWORD; the /1 suffix pins BullMQ
# (hardcoded "ibx" jobId prefix, not APP_ENV-namespaced) to DB index 1 —
# defense-in-depth on top of the dedicated container.
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:__GENERATE__@localhost:6380/1
NATS_URL=nats://localhost:4223
# T3-10 — per-role NATS client credentials (server-side enforcement in
# infra/nats/nats-server.test-plane.conf; rejection proven live by
# scripts/test-stack/nats-auth-probe.mjs):
#   • NATS_NKEY_SEED — the SUT app credential (api + commerce via
#     process-compose, ibx CLI seeding): publish + subscribe.
#   • IBX_TEST_NATS_CAPTURE_NKEY_SEED — the T1b-2 journeys NatsCapture
#     credential: SUBSCRIBE-ONLY (the server denies every publish).
#     connectNatsCapture() PREFERS this var and opens a dedicated connection,
#     so the observe plane cannot publish even though the harness env also
#     carries the app seed above.
#   • IBX_TEST_NATS_TRIGGER_NKEY_SEED — the T3-9 allowlisted journeys publish
#     helper credential: publish ibatexas.> ONLY, no subscribe. Reserved for
#     the single fingerprint-gated trigger helper (its IBX_TEST_FINGERPRINT
#     runtime gate + check-bypass leg 8 containment are unchanged).
NATS_NKEY_SEED=__GENERATE_NKEY_APP_SEED__
IBX_TEST_NATS_CAPTURE_NKEY_SEED=__GENERATE_NKEY_CAPTURE_SEED__
IBX_TEST_NATS_TRIGGER_NKEY_SEED=__GENERATE_NKEY_TRIGGER_SEED__
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8109
TYPESENSE_API_KEY=__GENERATE__
TYPESENSE_PROTOCOL=http
TYPESENSE_COLLECTION_NAME=products

# ─── Oracle read-only Postgres role (T1a-9 test-plane containment) ───────────
# scripts/test-stack/provision-oracle-role.sh (wired into test-stack-up.sh
# after the migrate step) creates role ibx_oracle_ro with SELECT-only on the
# public (kernel intent_audit tables) + ibx_domain (Prisma domain) schemas.
# The journeys oracle (@ibatexas/journeys — AuditReader, goal-state invariants)
# connects EXCLUSIVELY via ORACLE_DATABASE_URL; requireOracleDatabaseUrl()
# refuses any URL whose user is not ibx_oracle_ro. Write attempts as this role
# fail with insufficient_privilege (42501). Keep host/port/db in sync with
# DATABASE_URL above; the password must match IBX_TEST_ORACLE_PASSWORD.
IBX_TEST_ORACLE_PASSWORD=__GENERATE__
ORACLE_DATABASE_URL=postgresql://ibx_oracle_ro:__GENERATE__@localhost:5434/ibatexas_test

# ─── Sim-store writer Postgres role (T1b-5 — sim_runs / sim_results) ─────────
# scripts/test-stack/provision-sim-writer-role.sh (wired into test-stack-up.sh
# after `ibx journey migrate`) creates role ibx_sim_writer with INSERT/UPDATE
# on the sim_runs + sim_results tables ONLY — no SELECT, no other table, so
# the T1a-9 read-only oracle containment stays intact (two dedicated roles,
# never one widened role). `ibx journey run` persists one sim_runs row per
# attempt + sim_results rows per expects[] entry via SIM_DATABASE_URL;
# requireSimDatabaseUrl() refuses any URL whose user is not ibx_sim_writer.
# Keep host/port/db in sync with DATABASE_URL above; the password must match
# IBX_TEST_SIM_PASSWORD.
IBX_TEST_SIM_PASSWORD=__GENERATE__
SIM_DATABASE_URL=postgresql://ibx_sim_writer:__GENERATE__@localhost:5434/ibatexas_test

# ─── Secrets (>=32 chars, all distinct, explicit — see header) ────────────────
JWT_SECRET=__GENERATE__
STAFF_JWT_SECRET=__GENERATE__
COOKIE_SECRET=__GENERATE__
SESSION_HMAC_SECRET=__GENERATE__
PHONE_HASH_PEPPER=__GENERATE__
# Claustrum web-gateway signing key (claustrum-bootstrap requireSecret).
WEB_GATEWAY_SIGNING_KEY=__GENERATE__
AUDIT_REDACT_SECRET=__GENERATE__
ADMIN_API_KEY=__GENERATE__

# ─── LLM (certification pins — D-010) ─────────────────────────────────────────
# Interpolated from the developer's .env by gen-env-test.sh — NEVER committed.
ANTHROPIC_API_KEY=__FROM_DEV_ENV__
# Certification model: certifying runs require ANTHROPIC_MODEL to equal exactly
# this value (harness pre-flight asserts it). REQUIRED at boot (P0-6 fail-fast).
ANTHROPIC_MODEL=claude-sonnet-4-6
# DR-1 dev-profile escape (T1a-10): uncomment to let the harness pre-flight
# tolerate ANTHROPIC_MODEL != the certification target — the run is then
# MARKED non-certifying (recorded as such in sim_runs) instead of refused.
# Leave unset for certifying runs.
# IBX_JOURNEY_NON_CERTIFYING=1
# Local-model default for `ibx journey extraction-accuracy` calibration
# (FE-1 rollout, FE-D25): mirrors the dev .env's LLM_PROVIDER block so the
# api process talks to the local Nemotron box instead of silently falling
# back to the real Anthropic SDK client. This changes NOTHING for the
# certifying golden-conversation/journey suites above — those are fully
# scripted (a content-keyed ModelProvider double, zero tokens, zero network)
# and never construct either client. Without this block, an ephemeral
# calibration stack is BOTH a cost hazard (real Anthropic tokens spent
# silently) AND a correctness trap (live-caught, FE-T11): Anthropic's
# tool-use API rejects `input_schema`'s top-level `allOf`/`oneOf`/`anyOf` —
# the exact conditional-schema shape every per-capability extraction schema
# in this rollout emits (buildToolSurface, ibatexas-planner.ts) — so every
# turn 400s at the model-call layer before the planner ever runs, and the
# corpus driver silently times out case after case with zero signal as to
# why. Uncomment for any Nemotron-lane calibration run:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://192.168.1.80:11434/v1
# LLM_MODEL=nemotron-3-nano:4b
# LLM_API_KEY=ollama
# Persona test-driver model (T1a-8) — the LLM that role-plays the customer,
# NOT the SUT model. Optional; defaults to claude-sonnet-4-6. The driver
# accumulates conversation context per act (cost note: plan §7).
# IBX_DRIVER_MODEL=claude-sonnet-4-6
# REQUIRED at boot (P0-6 fail-fast) — id stamped on claustrum retrieval proofs.
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
# Optional — only needed if a journey exercises real embedding calls.
OPENAI_API_KEY=

# ─── JSONL trace events (T1a-13 — TEST PROFILE ONLY) ─────────────────────────
# IBX_EVENTS=json makes the @ibatexas/tools emitter write one JSON line per
# event to stderr; IBX_EVENTS_FILE additionally appends every line to the
# named file (append-mode, line-buffered). The api re-emits each Conductor
# turn's token usage as `llm.call {source:"sut"}` through this emitter, and
# `ibx journey run` parses the file for the SUT side of the cost report
# (driver-side llm.call events are captured in-process). Token counts only —
# never message content. NEVER set these in a dev or prod env file: unset
# means the emitter behaves exactly as before.
IBX_EVENTS=json
IBX_EVENTS_FILE=/tmp/ibx-test-events.jsonl

# ─── Third-party doubles ──────────────────────────────────────────────────────
# apps/api/src/config.ts requires these to be PRESENT at boot; journeys never
# call Twilio/Stripe live (auth uses the offline authFixture JWTs, T1a-4).
# Well-formed placeholders, useless outside the test stack.
TWILIO_ACCOUNT_SID=ACtest00000000000000000000000000
TWILIO_AUTH_TOKEN=test-auth-token-placeholder
TWILIO_VERIFY_SID=VAtest00000000000000000000000000
# STRIPE_SECRET_KEY stays an sk_test_ placeholder: its `sk_test_` prefix is
# LOAD-BEARING (the webhook route binds event.livemode=false to it —
# P3-SEC-STRIPESRC); no live Stripe call ever succeeds with it.
STRIPE_SECRET_KEY=sk_test_placeholder_journey_stack
# T2-1: the webhook secret is the TRUST ANCHOR of the paid-state fixture —
# the harness signs payment_intent.succeeded events with it and the route's
# stripe.webhooks.constructEvent verifies them. Generated per machine (never
# a shared placeholder) so a leaked template can never sign against a stack.
STRIPE_WEBHOOK_SECRET=whsec___GENERATE__

# ─── Medusa commerce (process-compose test profile boots it on :9000) ────────
MEDUSA_ADMIN_EMAIL=admin@test.ibatexas.local
MEDUSA_ADMIN_PASSWORD=__GENERATE__
MEDUSA_URL=http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ─── App URLs ─────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
