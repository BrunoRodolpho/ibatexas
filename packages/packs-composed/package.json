{
  "name": "@ibatexas/packs-composed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capability-definitions": {
      "types": "./dist/capability-definitions/index.d.ts",
      "import": "./dist/capability-definitions/index.js",
      "default": "./dist/capability-definitions/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "regen:intent-kinds": "tsx scripts/regenerate-intent-kinds.ts"
  },
  "dependencies": {
    "@adjudicate/core": "^1.6.0",
    "@ibatexas/pack-customer-onboarding": "workspace:*",
    "@ibatexas/pack-ops": "workspace:*",
    "@ibatexas/pack-orders": "workspace:*",
    "@ibatexas/pack-payments": "workspace:*",
    "@ibatexas/pack-reservations": "workspace:*",
    "@ibatexas/pack-whatsapp": "workspace:*"
  },
  "devDependencies": {
    "@adjudicate/pack-payments-pix": "^0.3.0",
    "@ibatexas/eslint-config": "workspace:*",
    "@ibatexas/intent-kinds": "workspace:*",
    "@ibatexas/types": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.6"
  }
}
