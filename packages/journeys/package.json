{
  "name": "@ibatexas/journeys",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Journey Registry + deterministic oracle kit for LLM-driven journey testing (test plane — never imported by apps/* or non-test packages/*)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/audit": "^2.0.1",
    "@adjudicate/audit-postgres": "^2.0.1",
    "@adjudicate/core": "^1.3.0",
    "@ibatexas/intent-kinds": "workspace:*",
    "@ibatexas/packs-composed": "workspace:*",
    "@ibatexas/tools": "workspace:*",
    "@ibatexas/types": "workspace:*",
    "pg": "^8.11.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ibatexas/eslint-config": "workspace:*",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.0",
    "testcontainers": "^12.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
