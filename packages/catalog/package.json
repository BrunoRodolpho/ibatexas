{
  "name": "@ibatexas/catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist && tsx scripts/check-catalog.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx scripts/check-catalog.ts",
    "check:claim-refs": "tsx scripts/check-claim-references.ts",
    "conformance:regen": "tsx scripts/regenerate-conformance-goldens.ts"
  },
  "dependencies": {
    "@adjudicate/core": "^1.6.0"
  },
  "devDependencies": {
    "@ibatexas/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.6"
  }
}
