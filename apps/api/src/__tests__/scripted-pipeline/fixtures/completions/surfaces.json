{
  "planner": {
    "system": "Você é o interpretador de intenções do atendimento da IbateXas.\nSua única função é traduzir o pedido do cliente em uma chamada de \"express_intent\".\nVocê NUNCA executa ações nem altera dados — apenas declara a intenção.\n\nREGRA PRINCIPAL: se o cliente pede QUALQUER ação (adicionar, remover, atualizar\nquantidade, aplicar cupom, criar carrinho, finalizar/pagar, cancelar, adicionar\nobservação, reservar, etc.), você DEVE chamar \"express_intent\" com a capability\ncorrespondente (exatamente uma das opções do enum). Faça isso MESMO que falte algum\ndetalhe (ex.: o id exato do item, do pedido ou do carrinho) — preencha o payload com\no que o cliente disse em linguagem natural (ex.: { item: 'linguiça' } ou\n{ quantidade: 3 }); o handler resolve os identificadores depois. NÃO peça confirmação\ne NÃO faça perguntas de esclarecimento aqui.\n\nUse as ferramentas de leitura apenas para consultar informações. Não invente\ncapabilities fora da lista. Só NÃO chame \"express_intent\" quando o cliente\nclaramente não pede nenhuma ação (ex.: perguntas sobre horário, cardápio ou preço).",
    "tools": [
      {
        "name": "express_intent",
        "description": "Declarar uma intenção de mutação para o kernel adjudicar. Use `capability` (uma das opções do enum) e `payload` com os dados.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string",
              "enum": [
                "order.cart.ensure",
                "order.item.add",
                "order.item.update",
                "order.item.remove",
                "order.coupon.apply",
                "order.checkout.create",
                "order.cancel",
                "order.amend.add_item",
                "order.amend.update_qty",
                "order.amend.remove_item",
                "order.note.add",
                "payment.pix.regenerate",
                "reservation.create",
                "reservation.modify",
                "reservation.cancel",
                "reservation.waitlist.join",
                "customer.preferences.update",
                "customer.pix.details.save",
                "whatsapp.handoff.request"
              ],
              "description": "A capability/intent kind a ser proposta."
            },
            "payload": {
              "type": "object",
              "description": "Dados da intenção (campos específicos da capability)."
            }
          },
          "required": [
            "capability",
            "payload"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.cart.ensure"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.item.add"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do carrinho (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      },
                      "quantity": {
                        "type": "number",
                        "description": "Quantidade do item a adicionar (padrão: 1 se não informado)."
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.item.update"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do carrinho (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      },
                      "quantity": {
                        "type": "number",
                        "description": "Nova quantidade desejada para o item no carrinho."
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.item.remove"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do carrinho (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.coupon.apply"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "description": "Código do cupom de desconto informado pelo cliente."
                      }
                    },
                    "required": [
                      "code"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.amend.add_item"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      },
                      "quantity": {
                        "type": "number",
                        "description": "Quantidade do item a adicionar (padrão: 1 se não informado)."
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.amend.update_qty"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      },
                      "quantity": {
                        "type": "number",
                        "description": "Nova quantidade desejada para o item."
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.amend.remove_item"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "order.note.add"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "body": {
                        "type": "string",
                        "description": "Texto da observação, EXATAMENTE como o cliente disse — nunca resuma, parafraseie ou invente conteúdo."
                      }
                    },
                    "required": [
                      "body"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "payment.pix.regenerate"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "reservation.create"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "timeSlotId": {
                        "type": "string",
                        "description": "ID do horário — SEMPRE um id já retornado por uma leitura anterior nesta conversa (check_availability), NUNCA inventado ou digitado pelo cliente."
                      },
                      "partySize": {
                        "type": "number",
                        "description": "Número de pessoas (1 a 20)."
                      }
                    },
                    "required": [
                      "timeSlotId",
                      "partySize"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "reservation.modify"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "newTimeSlotId": {
                        "type": "string",
                        "description": "ID do novo horário — SEMPRE um id já retornado por uma leitura anterior nesta conversa (check_availability). Omita se o cliente não quiser mudar o horário."
                      },
                      "newPartySize": {
                        "type": "number",
                        "description": "Novo número de pessoas (1 a 20). Omita se o cliente não quiser mudar a quantidade de pessoas."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "reservation.cancel"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "description": "Motivo do cancelamento, se mencionado. Omita se não houver motivo explícito."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "reservation.waitlist.join"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "timeSlotId": {
                        "type": "string",
                        "description": "ID do horário — SEMPRE um id já retornado por uma leitura anterior nesta conversa (check_availability), NUNCA inventado ou digitado pelo cliente."
                      },
                      "partySize": {
                        "type": "number",
                        "description": "Número de pessoas (1 a 20)."
                      }
                    },
                    "required": [
                      "timeSlotId",
                      "partySize"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "customer.preferences.update"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "dietaryFlags": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "freeform": true
                        },
                        "description": "Restrições alimentares mencionadas pelo cliente (ex.: [\"vegetariano\", \"sem glúten\"]). NUNCA inclua alergias aqui."
                      },
                      "favoriteCategories": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "freeform": true
                        },
                        "description": "Categorias favoritas mencionadas pelo cliente (ex.: [\"churrasco\", \"grelhados\"])."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "customer.pix.details.save"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "capability": {
                    "const": "whatsapp.handoff.request"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "description": "Motivo do pedido de atendimento humano, se mencionado. Omita se não houver motivo explícito."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "get_cart",
        "description": "Ferramenta de leitura: get_cart. Apenas consulta, não altera dados.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "check_order_status",
        "description": "Ferramenta de leitura: check_order_status. Apenas consulta, não altera dados.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "orderReference": {
              "type": "string",
              "description": "Número do pedido, SOMENTE se o cliente mencionar um explicitamente (ex.: \"1234\", \"#1234\"). Deixe de fora se não for mencionado — resolve automaticamente para o pedido mais recente."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "get_recommendations",
        "description": "Ferramenta de leitura: get_recommendations. Apenas consulta, não altera dados.",
        "inputSchema": {
