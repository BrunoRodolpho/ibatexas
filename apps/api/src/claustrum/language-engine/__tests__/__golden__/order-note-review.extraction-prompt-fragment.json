{
  "capabilities": [
    "order.note.add",
    "order.review.submit"
  ],
  "expressIntentTool": {
    "name": "express_intent",
    "description": "Declarar uma intenção de mutação para o kernel adjudicar. Use `capability` (uma das opções do enum) e `payload` com os dados.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "order.note.add",
            "order.review.submit"
          ],
          "description": "A capability/intent kind a ser proposta."
        },
        "payload": {
          "type": "object",
          "description": "Dados da intenção (campos específicos da capability)."
        }
      },
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "order.note.add"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "description": "Texto da observação, EXATAMENTE como o cliente disse — nunca resuma, parafraseie ou invente conteúdo."
                  }
                },
                "required": [
                  "body"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "order.review.submit"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "rating": {
                    "type": "number",
                    "description": "Nota de 1 a 5 dada pelo cliente."
                  },
                  "comment": {
                    "type": "string",
                    "description": "Comentário da avaliação, EXATAMENTE como o cliente disse. Omita se não houver comentário explícito."
                  }
                },
                "required": [
                  "rating"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
