{
  "capabilities": [
    "order.amend.add_item",
    "order.amend.update_qty",
    "order.amend.remove_item"
  ],
  "expressIntentTool": {
    "name": "express_intent",
    "description": "Declarar uma intenção de mutação para o kernel adjudicar. Use `capability` (uma das opções do enum) e `payload` com os dados.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "order.amend.add_item",
            "order.amend.update_qty",
            "order.amend.remove_item"
          ],
          "description": "A capability/intent kind a ser proposta."
        },
        "payload": {
          "type": "object",
          "description": "Dados da intenção (campos específicos da capability)."
        }
      },
      "required": [
        "capability",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "order.amend.add_item"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                  },
                  "quantity": {
                    "type": "number",
                    "description": "Quantidade do item a adicionar (padrão: 1 se não informado)."
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "order.amend.update_qty"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                  },
                  "quantity": {
                    "type": "number",
                    "description": "Nova quantidade desejada para o item."
                  }
                },
                "required": [
                  "item",
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "order.amend.remove_item"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "Referência em linguagem natural ao item do pedido (ex.: \"coca\", \"o hambúrguer\"). NUNCA um ID — a referência é resolvida pelo runtime."
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
