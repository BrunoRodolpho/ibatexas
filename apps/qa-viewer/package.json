{
  "name": "@ibatexas/qa-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Read-only QA viewer over the journey-harness artifacts (T2-5/DR-3): four derived graphs, coverage matrix, run explorer. Never an authoring surface.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.10.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
