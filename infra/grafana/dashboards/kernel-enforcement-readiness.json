{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-intent shadow divergence over 7d, with enforce-readiness gauge per intent_kind. Materialization of migration/06-observability-requirements.md §Dashboard 2.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Shadow→Enforce sequencing",
      "type": "link",
      "url": "https://github.com/ibatexas/ibatexas/blob/main/docs/adjudicate-migration/migration/04-shadow-enforce-sequencing.md"
    },
    {
      "title": "Rollout runbook",
      "type": "link",
      "url": "https://github.com/ibatexas/ibatexas/blob/main/docs/adjudicate-migration/runbooks/SHADOW-ENFORCE-ROLLOUT.md"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Divergence count per intent_kind, broken out by divergence class. NOTE: W3 metric-agent fixed the label from `divergence` to `class` — this panel uses `class`.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "events",
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["sum", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by(intent_kind, class) (increase(kernel_shadow_divergence_total{env=\"$env\", intent_kind=~\"$intent_kind\"}[7d]))",
          "legendFormat": "{{intent_kind}} / {{class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Divergence by intent_kind over 7d (class = BASIS_ONLY | DECISION_KIND | PAYLOAD_REWRITE)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Ready-to-enforce gauge. Green = no DECISION_KIND / PAYLOAD_REWRITE divergence in last 7d AND BASIS_ONLY ratio < tier threshold. Red = any blocking divergence.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "BLOCKED" },
                "1": { "color": "green", "index": 1, "text": "ENFORCE-READY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(sum by(intent_kind) (increase(kernel_shadow_divergence_total{env=\"$env\", class=~\"DECISION_KIND|PAYLOAD_REWRITE\", intent_kind=~\"$intent_kind\"}[7d])) == bool 0)",
          "legendFormat": "{{intent_kind}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Enforce-ready gauge per intent_kind (7d window, blocking-class clean)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "BASIS_ONLY divergence ratio. Tier 1 threshold = 5%, Tier 4 threshold = 1%. Sustained breach blocks enforce flip.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "ratio",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["last", "mean", "max"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by(intent_kind) (increase(kernel_shadow_divergence_total{env=\"$env\", class=\"BASIS_ONLY\", intent_kind=~\"$intent_kind\"}[24h])) / clamp_min(sum by(intent_kind) (increase(kernel_decision_total{env=\"$env\", intent_kind=~\"$intent_kind\"}[24h])), 1)",
          "legendFormat": "{{intent_kind}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "BASIS_ONLY divergence ratio per intent_kind (24h rolling)",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["kernel", "adjudicate", "enforce-readiness", "wave-3"],
